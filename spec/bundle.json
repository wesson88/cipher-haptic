      "since": "1.0.0"
    },
    "notify.message": {
      "category": "alert",
      "desc": "普通消息/提示到达",
      "effect": "message_ping",
      "since": "1.0.0"
    },
    "security.intrusion": {
      "category": "critical",
      "desc": "检测到防窥入侵（截屏/录屏），惩罚性强警报",
      "effect": "anti_screenshot",
      "since": "1.0.0"
    },
    "selection.snap": {
      "category": "ux",
      "desc": "元素吸附到位（对齐、吸附、咬合）",
      "effect": "magnetic_snap",
      "since": "1.0.0"
    }
  },
  "transitions": {
    "events": [
      "SUBMIT",
      "SUBMIT_OK",
      "NATURAL_END",
      "UPDATE",
      "CANCEL",
      "SUSPEND",
      "RESUME",
      "FAIL",
      "GRACE_EXPIRED",
      "EXPIRE"
