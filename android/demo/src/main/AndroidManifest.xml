<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P-18：Android 独有的失败模式。缺权限时库静默降级 + 指标，不崩。 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- V3 待验证的那道防线（P-10）。若实测无效，这行和 AndroidWakeLock 一起删。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- V3：前台服务是 ROM 一般不冻的那一类；AlarmManager 精确闹钟穿透 Doze。
         ⚠️ 这是【测试夹具】的需要，不是库的推荐用法 —— 见主文档 A.1b：
         后台告警应走 NotificationChannel 让系统代振，而不是自己搭前台服务。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:label="CipherHaptic 调音台"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".TuningActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- V3：熄屏 / Doze 下的触发器。Activity 在熄屏时 onStop，而 am start 又会
             点亮屏幕 —— 于是"熄屏下的表现"永远测不到。Receiver 没有这个问题。 -->
        <receiver
            android:name=".V3Receiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.cipherlex.haptic.demo.V3" />
            </intent-filter>
        </receiver>

        <service
            android:name=".V3Service"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="haptic scheduling latency measurement (V3)" />
        </service>
    </application>
</manifest>
